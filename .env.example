# Bullet Game's whole deployment. Copy it to .env, which docker-compose.yml
# beside it reads: the bot gets all of it through env_file, and the web build
# gets the VITE_ names. .env is kept out of git and out of both images.

# --- Telegram
# From @BotFather. Only one process may poll a bot token, so give Bullet a bot
# of its own.
BULLET_TELEGRAM_TOKEN=
# Comma-separated Telegram group or channel ids to host games in; empty: any group the bot is in.
BULLET_CHATS=
# Comma-separated Telegram user ids allowed to /abort.
BULLET_ADMINS=
# The bot's username without the @, for the page's links. Rebuild the web service after changing it.
VITE_BULLET_BOT=zvm_bullet_bot

# --- Chain
# No node is built in. These are a local zvm-devnet's, at its default address
# (https://github.com/Zenoglyphs-VM/zvm-devnet). ZVM_RPC is the JSON-RPC the bot and the
# deploy commands use (BULLET_RPC overrides it for the bot alone), and ZVM_NODE
# the node's API, for verification.
ZVM_RPC=http://localhost:47080/zvm/rpc
ZVM_NODE=http://localhost:47080/zvm
# Where the explorer, swap page and these docs are, for links in the bot's
# messages (BULLET_PUBLIC overrides it) and on the page.
ZVM_GATEWAY=http://localhost:47080
VITE_GATEWAY=http://localhost:47080

# ZNS's ENSRegistry on this chain (zvm-zns's deployment record), for names in
# the bot's messages. Empty: addresses only.
ZNS_REGISTRY=

# --- Files, as the container sees them (docker-compose.yml mounts and bakes these)
BULLET_KEYS=/run/secrets/bullet.json
BULLET_RECORD=/etc/zvm-bullet/zvm.json
BULLET_DB=/data/bullet.db

# --- Game
# How long a game waits for players, and how long a player has before the bot pulls for them.
BULLET_JOIN_WINDOW=2m
BULLET_AFK=30s
# Largest revolver /roulette accepts.
BULLET_MAX_SIZE=12

# --- Live tests only (go test ./internal/game). Not read from this file on
# purpose: set, they make every `go test ./...` spend devnet ZNN, so export
# them in the shell for the run that means it. Absolute paths.
# BULLET_LIVE_RPC=
# BULLET_LIVE_RECORD=
# BULLET_LIVE_KEYS=
# BULLET_LIVE_TG_CHAT=
