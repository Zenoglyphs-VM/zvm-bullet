# Working notes, handoffs and logs: the state of a session, not of the code.
HANDOFF*.md
handoff*.md
PROGRESS.md
progress.md
NOTES*.md
notes*.md
notes/
TODO.md
WISHLIST.md
ideas.txt
scratch/
*.log
*.out
.claude/
CLAUDE.md
CLAUDE.local.md

# Secrets. Keys, passwords and tokens belong to one deployment and are never
# shared; .env.example is the template that is.
.env
*.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.keystore
jwt.hex
network-private-key
wallet/

# Local state.
*.db
*.db-shm
*.db-wal
*.sqlite
*.tmp

# Editors and operating systems.
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# Build output.
bin/
*.exe
*.exe~
*.test

# Dependencies and build output of the page and the contract scripts.
web/node_modules/
web/dist/
contracts/node_modules/

# Deployment records: what one devnet deployed, written by the deploy scripts.
# Every devnet deploys its own, so none is shared here. A Pages build is
# handed its record by the workflow, from the organisation's Actions variables.
deployments/**/*.json
